# Environment Variables for AI Criminal Network Analysis System

# Django Settings
DJANGO_SECRET_KEY=django-insecure-criminal-network-analysis-secret-key-change-in-prod-2026
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000

# PostgreSQL Database
POSTGRES_DB=criminal_network_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password_2026
NEO4J_HTTP_PORT=7474

# Redis Queue
REDIS_URL=redis://redis:6379/0

# Backend Service
BACKEND_PORT=8000

# Frontend Service
FRONTEND_PORT=5173
